nextflow_workflow {

    name "Test reproducibility metadata"
    script "tests/workflows/metadata-fixture.nf"

    test("Should write deterministic checksum, version, and container metadata") {
        workflow "METADATA_FIXTURE"

        when {
            params {
                metadataDir = ".nf-test/results/metadata-positive"
            }
        }

        then {
            assert workflow.success

            def checksumFile = path(workflow.out.checksums.get(0))
            def checksumRows = checksumFile.readLines()
            assert checksumRows[0] ==
                "sample_id\trole\tabsolute_path\tsize_bytes\tsha256"
            assert checksumRows[1].startsWith(
                "reference\treference_fasta\t"
            )
            assert checksumRows[1].endsWith(
                "\t27\tfc81e5e00a24b59561d5ae85ccb19d631d4b044581fe02f19348fda9f38a267f"
            )

            def versionRows = path(workflow.out.versions.get(0)).readLines()
            assert versionRows[0] ==
                "mode\ttool\tversion\tcontainer\texit_status\traw_output"
            assert versionRows[1].contains("\tbcftools\t")
            assert versionRows[1].contains("bcftools 1.21")

            def containerRows = path(workflow.out.containers.get(0)).readLines()
            assert containerRows[0] ==
                "name\tkind\tidentity\tsize_bytes\tsha256"
            def containersByName = containerRows.drop(1).collectEntries { row ->
                [(row.split("\t", 2)[0]): row]
            }
            assert containersByName.test_remote ==
                "test_remote\tremote_uri\tdocker://example/test:1.0\tNA\tNA"
            assert containersByName.test_sandbox.startsWith(
                "test_sandbox\tlocal_sandbox\t"
            )
            assert containersByName.test_sandbox.endsWith("\tNA\tNA")
            assert containersByName.test_sif.startsWith(
                "test_sif\tlocal_sif\t"
            )
            assert containersByName.test_sif.endsWith(
                "\t27\tfc81e5e00a24b59561d5ae85ccb19d631d4b044581fe02f19348fda9f38a267f"
            )
        }
    }

    test("Should classify local SIF and sandbox containers") {
        workflow "CLASSIFY_LOCAL_CONTAINERS_FIXTURE"

        then {
            assert workflow.success
            def specs = workflow.out.specsCh.get(0)
            assert specs*.name == ["sandbox", "sif"]
            assert specs*.kind == ["local_sandbox", "local_sif"]
        }
    }

    test("Should reject a missing local container") {
        workflow "MISSING_CONTAINER_FIXTURE"

        then {
            assert workflow.failed
            assert workflow.errorReport.contains(
                "Configured SIF file does not exist"
            )
        }
    }

    test("Should normalize parameter values for JSON") {
        workflow "NORMALIZE_METADATA_FIXTURE"

        then {
            assert workflow.success
            def normalized = workflow.out.normalizedCh.get(0)
            assert normalized.null_value == null
            assert normalized.enabled == true
            assert normalized.count == 3
            assert normalized.memory == "4 GB"
            assert normalized.values == ["a", 2]
            assert normalized.path.endsWith(
                "/tests/data/bcftools/ref.fa"
            )
        }
    }

    test("Should feed containerSpecs tuples into the container metadata process") {
        workflow "CONTAINER_SPECS_FIXTURE"

        when {
            params {
                mode = "NANOPORE"
                // Stands in for a built SIF: any regular file exercises the
                // local_sif branch and gives a deterministic checksum.
                base_container = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }

        then {
            assert workflow.success

            def rows = workflow.out.rows.collect { row ->
                path(row).readLines()[0].split("\t", -1)
            }
            // Every row must carry all five columns.
            assert rows.every { fields -> fields.size() == 5 }

            def byName = rows.collectEntries { fields -> [(fields[0]): fields] }
            assert byName.keySet() == ["nanopore_base", "clair3"] as Set

            // Column order is the contract: name, kind, identity, size, sha256.
            def base = byName.nanopore_base
            assert base[1] == "local_sif"
            assert base[2].endsWith("/tests/data/bcftools/ref.fa")
            assert base[3] == "27"
            assert base[4] ==
                "fc81e5e00a24b59561d5ae85ccb19d631d4b044581fe02f19348fda9f38a267f"

            def clair3 = byName.clair3
            assert clair3[1] == "remote_uri"
            assert clair3[2].startsWith("docker://hkubal/clair3")
            assert clair3[3] == "NA"
            assert clair3[4] == "NA"
        }
    }

    test("Should declare every ILLUMINA container as a local image") {
        workflow "CONTAINER_SPECS_TUPLES_FIXTURE"

        when {
            params {
                mode = "ILLUMINA"
                virus = "sars-cov2"
                runSnpEff = true
            }
        }

        then {
            assert workflow.success

            def specs = workflow.out.containerSpecsCh
            def byName = specs.collectEntries { spec -> [(spec[0]): spec] }

            // runIntraHostScript briefly ran from a registry image because it
            // had no container at all before this branch. It shares
            // runReadCounts' container instead, so there is nothing extra to
            // declare here - but that only holds while no ILLUMINA process
            // reaches for a registry again, which is what this asserts.
            //
            // Local, but not necessarily a .sif: localContainerSpec() picks the
            // kind by asking whether the path is a directory *at runtime*, and
            // build_containers.py builds pangolin and snpeff with --sandbox, so
            // those two are local_sandbox on any machine that has actually run
            // it. Asserting local_sif for all of them held only where the
            // ILLUMINA images are absent - a fresh checkout, and CI, which
            // builds nothing but the nanopore image - and failed on a
            // provisioned ILLUMINA machine, which is the wrong way round.
            assert specs.every { spec -> spec[1] in ["local_sif", "local_sandbox"] }
            assert specs.every { spec -> !spec[2].contains("://") }

            assert byName.containsKey("intrahost_analysis")
            // Column order is the contract: name, kind, identity.
            assert byName.intrahost_analysis[2]
                .endsWith("/containers/intrahost_analysis:1.1.0.sif")
        }
    }

    test("Should build toolSpecs tuples in the order captureToolVersion expects") {
        workflow "TOOL_SPECS_FIXTURE"

        when {
            params {
                mode = "NANOPORE"
                base_container = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }

        then {
            assert workflow.success

            def specs = workflow.out.toolSpecsCh
            assert specs.every { spec -> spec.size() == 4 }

            // Position 0 is the mode, 1 the tool, 2 the version command, 3 the
            // container. Each assertion fails if the fields are reordered.
            assert specs.every { spec -> spec[0] == "NANOPORE" }
            // nf-test sorts channel emissions, so compare as a set. bamutil is
            // absent because trimLen defaults to 0 and runBamUtils therefore
            // never runs; the test below covers the enabled case.
            assert specs.collect { spec -> spec[1] }.toSorted() == [
                "bcftools", "clair3", "minimap2", "porechop_abi", "samtools"
            ]
            assert specs.every { spec -> spec[2].contains(spec[1].replace("_abi", "")) }
            assert specs.every { spec -> spec[2] =~ /(-v|--version)/ }

            def byTool = specs.collectEntries { spec -> [(spec[1]): spec] }
            assert byTool.bcftools[3].endsWith("/tests/data/bcftools/ref.fa")
            assert byTool.clair3[3].startsWith("docker://hkubal/clair3")
        }
    }

    test("Should declare bamUtil only when read-end trimming is enabled") {
        workflow "TOOL_SPECS_FIXTURE"

        when {
            params {
                mode = "NANOPORE"
                base_container = "${projectDir}/tests/data/bcftools/ref.fa"
                // A String, as the command line delivers it: the gate reads the
                // same normalizeTrimLen the workflow uses to decide whether
                // runBamUtils runs, so both agree on what "enabled" means.
                trimLen = "30"
            }
        }

        then {
            assert workflow.success

            def specs = workflow.out.toolSpecsCh
            def byTool = specs.collectEntries { spec -> [(spec[1]): spec] }

            assert byTool.containsKey("bamutil")
            assert byTool.bamutil[0] == "NANOPORE"
            // bamUtil has no --version flag, so the other tools' pattern does
            // not apply: `bam` alone exits 255 without printing one, and
            // `bam help` puts it on the second line. sed, not head, because
            // `bam help` keeps writing and an early close exits 141 under
            // pipefail - which captureToolVersion would record as a failure.
            assert byTool.bamutil[2] == "bam help 2>&1 | sed -n 2p"
            assert byTool.bamutil[3].endsWith("/tests/data/bcftools/ref.fa")

            // The trimming tool is the only addition; nothing else changes.
            assert specs.collect { spec -> spec[1] }.toSorted() == [
                "bamutil", "bcftools", "clair3", "minimap2", "porechop_abi", "samtools"
            ]
        }
    }

    test("Should ignore an absent optional GFF") {
        workflow "OPTIONAL_GFF_METADATA_FIXTURE"

        when {
            params {
                mode = "NANOPORE"
                samplesheet = "${projectDir}/tests/data/input/nanopore-single.csv"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }

        then {
            assert workflow.success
            assert workflow.out.gffMetadataCh.size() == 0
            assert workflow.out.fastaMetadataCh.size() == 1
            assert workflow.out.fastaMetadataCh.get(0)[1] == "reference_fasta"
        }
    }

    test("Should record reference metadata for a custom virus given explicit paths") {
        workflow "OPTIONAL_GFF_METADATA_FIXTURE"

        when {
            params {
                mode = "ILLUMINA"
                virus = "custom"
                runSnpEff = false
                samplesheet = "${projectDir}/tests/data/input/illumina-multilane.csv"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
                referenceGFF = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }

        then {
            assert workflow.success

            assert workflow.out.gffMetadataCh.size() == 1
            def gff = workflow.out.gffMetadataCh.get(0)
            assert gff[0] == "reference"
            assert gff[1] == "referenceGff"
            assert gff[2].startsWith("/")
            assert gff[2].endsWith("/tests/data/bcftools/ref.fa")

            assert workflow.out.fastaMetadataCh.size() == 1
            def fasta = workflow.out.fastaMetadataCh.get(0)
            assert fasta[1] == "reference_fasta"
            assert fasta[2].endsWith("/tests/data/bcftools/ref.fa")
        }
    }
}
