nextflow_pipeline {
    name "Canonical sample input handling"
    script "tests/workflows/input-fixture.nf"

    test("Consolidates repeated Nanopore rows into one logical sample") {
        when {
            params {
                mode = "NANOPORE"
                samplesheet = "${projectDir}/tests/data/input/nanopore-multichunk.csv"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().findAll { it.name.contains('prepareSampleReads') }.size() == 1
            assert workflow.stdout.any {
                it.contains('PREPARED sample_a paired=false files=sample_a.SE.fastq.gz batch=batch_1')
            }
        }
    }

    test("Rejects a source file assigned more than once") {
        when {
            params {
                mode = "NANOPORE"
                samplesheet = "${projectDir}/tests/data/input/reused-fastq.csv"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains('is already assigned') }
        }
    }

    // A FASTQ can be non-empty on disk and still hold no reads - gzip of
    // nothing is 20 bytes - which slipped past the zero-byte check. Downstream,
    // Porechop_ABI then aborted with "Unable to build graph" and took every
    // other sample in the run with it. All three read-less forms must be named
    // in one report, and the valid sample beside them must not be.
    test("Rejects FASTQ files that hold no reads") {
        when {
            params {
                mode = "NANOPORE"
                samplesheet = "${projectDir}/tests/data/input/nanopore-no-reads.csv"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }
        then {
            assert workflow.failed
            // Rejected before any task is submitted, Porechop included.
            assert workflow.trace.tasks().isEmpty()
            assert workflow.stdout.any {
                it.contains('sample-sheet row 2 fastq_1: FASTQ contains no reads') &&
                    it.contains('no_reads.fastq.gz')
            }
            assert workflow.stdout.any {
                it.contains('sample-sheet row 3 fastq_1: FASTQ contains no reads') &&
                    it.contains('blank_lines.fastq')
            }
            // A .gz that is not gzip gets a validation message, not a stack
            // trace from deep inside the reader.
            assert workflow.stdout.any {
                it.contains('sample-sheet row 4 fastq_1: FASTQ cannot be read as gzip') &&
                    it.contains('not_gzip.fastq.gz')
            }
            assert !workflow.stdout.any { it.contains('sample-sheet row 5') }
        }
    }

    test("Rejects mixed single and paired rows") {
        when {
            params {
                mode = "ILLUMINA"
                virus = "custom"
                samplesheet = "${projectDir}/tests/data/input/mixed-layout.csv"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
                referenceGFF = "${projectDir}/tests/data/bcftools/ref.fa"
                runSnpEff = false
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any {
                it.contains('mixes single-end and paired-end rows')
            }
        }
    }

    test("Rejects conflicting input interfaces") {
        when {
            params {
                mode = "NANOPORE"
                inDir = "${projectDir}/tests/data/input"
                samplesheet = "${projectDir}/tests/data/input/nanopore-multichunk.csv"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any {
                it.contains('--samplesheet and --inDir cannot be used together')
            }
        }
    }

    test("Discovers an uncompressed FASTQ pair") {
        when {
            params {
                mode = "ILLUMINA"
                virus = "custom"
                inDir = "${projectDir}/tests/data/legacy-input/uncompressed-fastq"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
                referenceGFF = "${projectDir}/tests/data/bcftools/ref.fa"
                runSnpEff = false
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().findAll { it.name.contains('prepareSampleReads') }.size() == 1
            assert workflow.stdout.any { it.contains('PREPARED sample_fastq paired=true files=sample_fastq.R1.fastq.gz,sample_fastq.R2.fastq.gz') }
        }
    }

    test("Discovers an uncompressed FQ pair") {
        when {
            params {
                mode = "ILLUMINA"
                virus = "custom"
                inDir = "${projectDir}/tests/data/legacy-input/uncompressed-fq"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
                referenceGFF = "${projectDir}/tests/data/bcftools/ref.fa"
                runSnpEff = false
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.tasks().findAll { it.name.contains('prepareSampleReads') }.size() == 1
            assert workflow.stdout.any { it.contains('PREPARED sample_fq paired=true files=sample_fq.R1.fastq.gz,sample_fq.R2.fastq.gz') }
        }
    }

    test("Rejects an uncompressed orphan Illumina mate") {
        when {
            params {
                mode = "ILLUMINA"
                virus = "custom"
                inDir = "${projectDir}/tests/data/legacy-input/orphan"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
                referenceGFF = "${projectDir}/tests/data/bcftools/ref.fa"
                runSnpEff = false
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any {
                it.contains("Legacy input sample 'orphan' has an orphan Illumina mate")
            }
        }
    }

    // _R1 marks a mate only in ILLUMINA. A Nanopore file that happens to be
    // named *_R1.fastq is one single-end sample, named after the whole file
    // as any other single file is.
    test("Discovers a lone _R1 file as a Nanopore sample") {
        when {
            params {
                mode = "NANOPORE"
                inDir = "${projectDir}/tests/data/legacy-input/orphan"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }
        then {
            assert workflow.success
            assert workflow.stdout.any {
                it.contains('PREPARED orphan_R1 paired=false files=orphan_R1.SE.fastq.gz')
            }
        }
    }

    // A complete pair in NANOPORE mode is most likely Illumina data given the
    // wrong --mode, so it is refused rather than run as two samples.
    test("Rejects an _R1/_R2 pair in NANOPORE mode") {
        when {
            params {
                mode = "NANOPORE"
                inDir = "${projectDir}/tests/data/legacy-input/uncompressed-fastq"
                referenceGenome = "${projectDir}/tests/data/bcftools/ref.fa"
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any {
                it.contains('legacy sample sample_fastq: fastq_2 must be empty in NANOPORE mode')
            }
        }
    }
}
