nextflow_workflow {

    name "Tool version parsing"
    script "tests/workflows/toolversion-fixture.nf"
    workflow "TOOLVERSION_FIXTURE"

    test("Should record the first version-like token, whatever the format") {

        when {
            workflow {
                """
                """
            }
        }

        then {
            assert workflow.success

            // One row per tool: mode, tool, version, container, exit_status, raw_output.
            def parsed = workflow.out[0].collect { versionFile ->
                path(versionFile).readLines().findAll { it.trim() }.first().split("\t")
            }.collectEntries { fields -> [(fields[1]): fields[2]] }

            // Three-component versions: every one of these was truncated before.
            assert parsed.clair3 == "v1.2.0"
            assert parsed.porechop_abi == "0.5.1"
            assert parsed.fastp == "0.23.2"
            assert parsed.ivar == "1.3.1"
            assert parsed.nextclade == "3.18.0"

            // Two-component versions, which the old expression happened to get
            // right - kept so a future rewrite cannot regress them.
            assert parsed.bcftools == "1.21"
            assert parsed.mafft == "v7.505"

            // A suffixed release: the trailing -r1209 belongs to the version.
            assert parsed.minimap2 == "2.28-r1209"

            // Nothing version-shaped in the output: fall back to the cleaned
            // text rather than inventing a version.
            assert parsed.unversioned == "no version here"
        }
    }
}
