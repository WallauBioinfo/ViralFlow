// getMappedReads and getUnmappedReads take their image from configs/containers.config,
// which points at the ILLUMINA-only generate_consensus SIF. CI runs the suite under
// -profile docker and only builds the nanopore base image, so point them at
// params.base_container instead: it resolves to the local SIF under the singularity
// profile and to the Docker tag under the docker profile, and it carries samtools
// either way. A closure, like the NP_basecontainer label, so it resolves per task
// once the parameters are final.
process {
    withName: 'getMappedReads|getUnmappedReads' {
        container = { params.base_container }
    }
}
