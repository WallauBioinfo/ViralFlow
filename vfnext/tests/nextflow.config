/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/
// Test-specific configuration
params.outDir = "test_results"
outputDir = params.outDir

// nextflow.config built these paths from the default outDir while it was
// parsed, before this file set the one above, so repeat them here - as with
// outputDir - to keep them in the test's RUN_METADATA like any real run.
// nf-test still moves the trace to its own meta/trace.csv with -with-trace;
// run_manifest.json records wherever each file actually went.
report.file = "${params.outDir}/RUN_METADATA/execution_report.html"
timeline.file = "${params.outDir}/RUN_METADATA/execution_timeline.html"
trace.file = "${params.outDir}/RUN_METADATA/execution_trace.tsv"

// Pin Clair3 by digest for tests. Overriding the parameter rather than the
// process directive keeps the run metadata reporting the image actually used.
params.clair3_container = "docker://hkubal/clair3@sha256:1430f7b520674bb282b5a1ba165e8555b012df67b9cdb22ff3d48f26cf1474a3"

// Test-specific process settings
process {
    cpus = 1
    memory = '1 GB'

    // The NP_basecontainer image comes from params.base_container, which
    // already defaults to containers/baseContainer.sif. Build it from
    // containers/Nanopore_baseContainer.sing before running tests that
    // execute Nanopore modules, or point --base_container elsewhere.

    withName: runClair3 {
        cpus = 4
        memory = '4 GB'
    }
}
