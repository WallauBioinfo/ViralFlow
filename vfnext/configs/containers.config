singularity {
    enabled = true
    autoMounts = true
    // --- GAMBIARRA ALERT ----------------------------------------------------
    // snpEff builds its database on the exec path, so it needs to write inside
    // its container. That needs '--writable-tmpfs', which applies to every
    // container and not just snpEff's, so it is not set here as a global
    // default. '-profile singularity' carries it instead.
    //
    // An earlier version switched on System.properties['os.arch'] and asked for
    // '--writable' on amd64. That cannot work for most of these images:
    // '--writable' needs a sandbox directory, and only pangolin and snpeff are
    // built that way (see build_containers.py) - the rest are pulled as real
    // .sif files, which Singularity can only open read-only.
    // '--writable-tmpfs' is the arch-independent option and is what the
    // profile uses.
    //
    // The proper fix is still to point snpEff at a writable location outside
    // the container.
    // ------------------------------------------------------------------------
}

process {
    withName:prepareDatabase{
        container = "$projectDir/containers/edirect:1.1.0.sif"
    }
    withName:indexReferenceBWA {
        container = "$projectDir/containers/generate_consensus:2.0.0.sif"
    }
    withName:runFastp {
        container = "$projectDir/containers/fastp:1.0.1.sif"
    }
    withName:runIvar {
        container = "$projectDir/containers/generate_consensus:2.0.0.sif"
    }
    withName:align2ref {
        container = "$projectDir/containers/generate_consensus:2.0.0.sif"
    }
    withName:runAmpliconClipping {
        container = "$projectDir/containers/samtools:1.11.0.sif"
    }
    withName:runReadCounts {
        container = "$projectDir/containers/intrahost_analysis:1.1.0.sif"
    }
    withName:alignConsensus2Ref {
        container = "$projectDir/containers/mafft:7.505_2.sif"
    }
    withName:runPangolin{
        container = "$projectDir/containers/pangolin:4.4.sif"
    }
    withName:runNextClade{
        container = "$projectDir/containers/nextclade:3.18.sif"
    }
    withName:runPicard{
       container = "$projectDir/containers/picard:2.27.2_2.sif"
    }
    withName:runSnpEff{
        container = "$projectDir/containers/snpeff:5.0.sif"
    }
    withName:genFaIdx{
        container = "$projectDir/containers/generate_consensus:2.0.0.sif"
    }
    withName:getMappedReads{
        container = "$projectDir/containers/generate_consensus:2.0.0.sif"
    }
    withName:getUnmappedReads{
        container = "$projectDir/containers/generate_consensus:2.0.0.sif"
    }
    withName:checkSnpEffDB{
        container = "$projectDir/containers/snpeff:5.0.sif"
    }
    withName:runVfReport{
        container = "$projectDir/containers/generate_report:1.1.0.sif"
    }
    withName:coveragePlot{
        container = "$projectDir/containers/generate_plots:2.0.0.sif"
    }
    withName:snpPlot{
        container = "$projectDir/containers/generate_plots:2.0.0.sif"
    }
    withName:compileOutputs{
        container = "$projectDir/containers/compiled_outputs:1.1.0.sif"
    }
    // The same image runReadCounts uses. It was built for this pair of
    // processes - bam-readcount for one, and the biopython/pandas/numpy
    // intrahost.py imports for the other - which is why it is named for the
    // analysis rather than for a tool.
    withName:runIntraHostScript{
        container = "$projectDir/containers/intrahost_analysis:1.1.0.sif"
    }
}
