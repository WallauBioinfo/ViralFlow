profiles {


    singularity {
        singularity {
            enabled = true
            autoMounts = true
            runOptions = "--writable-tmpfs"
        }
    }

    // For CI runners and developer machines without Singularity/Apptainer,
    // notably Apple Silicon. Build the image first:
    //
    //   cd vfnext/containers
    //   docker build -f nanopore_base.Dockerfile -t viralflow/nanopore-base:2.0.0a1 .
    //
    // Overriding params.base_container here works because the NP_basecontainer
    // container directive is a closure, resolved per task after profiles are
    // merged. ILLUMINA mode still expects local .sif files and is not covered
    // by this profile.
    docker {
        singularity {
            enabled = false
        }

        apptainer {
            enabled = false
        }

        docker {
            enabled = true
            // Write task outputs as the invoking user rather than root.
            runOptions = '-u $(id -u):$(id -g)'
        }

        params {
            base_container = 'viralflow/nanopore-base:2.0.0a1'
        }
    }

    apptainer {
        // no docker
        docker {
            enabled = false
        }

        singularity {
            enabled = false
        }

        apptainer {
            enabled = true
            autoMounts = true
        }
    }

    // Basic configuration to run locally at HPC (Fiocruz)
    fiocruz_default {
        // no docker
        docker {
            enabled = false
        }

        // set singulty options
        singularity { // /sw/singularity/bin/singularity
            enabled = true
            autoMounts = true
            runOptions = "--bind /storage,/storage1,/storage2,/sw"
        }

        executor {
            name = "local"
            cpus = 96
        }
    }

    // Config for PBS environment (Fiocruz)

    fiocruz_pbs {

        executor {
            name = 'pbs'
        }
        // no docker
        docker {
            enabled = false
        }

        // singulirity options
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "./"
            runOptions = "--bind /storage,/storage1,/storage2,/sw"
        }

        process {
            cpus = 1
            memory = 1.GB
            queue = "normq"
            errorStrategy = {task.attempt <= 3 ? 'retry' : 'terminate'}
            maxRetries = 2
        }

        executor {
            name = "pbs"
            perJobMemLimit = true
            // Maximum number of jobs to spawn at once - adjust as necessary
            queueSize = 100
            //jobName = { "vfnext - $task.name - $task.hash" }
            pollInterval = "2 sec"
        }
    }
}
