Bootstrap: docker
From: debian:12-slim

%environment
    export PATH=/opt/conda/bin:$PATH

%post
set -e
apt-get update -y
apt-get install -y --no-install-recommends ca-certificates curl bzip2 procps

# Use a current base rather than upgrading the solver inside Miniconda 4.7.12.
# Preserve /opt/conda/share/snpeff-5.0-3 for custom database maintenance.
curl -fLsS https://micro.mamba.pm/api/micromamba/linux-64/1.5.7 -o /tmp/micromamba.tar.bz2
tar -xjf /tmp/micromamba.tar.bz2 -C /usr/local bin/micromamba
export MAMBA_ROOT_PREFIX=/opt/conda
export PATH=/opt/conda/bin:$PATH
micromamba --no-rc create -y -p /opt/conda \
    --override-channels -c conda-forge -c bioconda --strict-channel-priority \
    snpeff=5.0=hdfd78af_3 openjdk=17 entrez-direct procps-ng
snpEff download NC_045512.2
test -s /opt/conda/share/snpeff-5.0-3/data/NC_045512.2/snpEffectPredictor.bin
apt-get clean
micromamba --no-rc clean --all --yes
rm -f /tmp/micromamba.tar.bz2
rm -rf /var/lib/apt/lists/* /usr/share/man /usr/share/doc /usr/share/locale

%runscript
cd /
exec /bin/bash "$@"

%startscript
cd /
exec /bin/bash "$@"
