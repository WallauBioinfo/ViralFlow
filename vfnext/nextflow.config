includeConfig './configs/containers.config'

manifest {
    name            = 'ViralFlow'
    author          = 'Wallau Lab'
    homePage        = 'https://github.com/WallauBioinfo/ViralFlow'
    description     = 'performs a reference guided genome assembly of non-segmented viruses'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version         = '2.0.0a1'
}

params {

   mode = "ILLUMINA" // accepted "ILLUMINA" or "NANOPORE"

  // parameters user must provide
  primersBED=null

  // parameters user should be aware, but have default values
  virus = "sars-cov2" // accepted values are ("sars-cov2", "custom")
  inDir = null
  samplesheet = null
  outDir = "$launchDir/output/"

  // snpEff
  snpEffDBCatalog = "$projectDir/containers/snpEff_DB.catalog"
  databaseDir = "$projectDir/databases/"
  runSnpEff = true

  // fastp
  dedup = false
  ndedup = 3

  writeMappedReads = true

  // process parameters
  minLen = 75
  depth = 25
  minDpIntrahost = 100
  trimLen = 0

  // parameter to be set by user if a custom virus is used
  refGenomeCode=null
  referenceGFF=null
  referenceGenome=null

  // set available resources for nextflow
  nextflowSimCalls = 6

  // set quality params
  mapping_quality = 30
  base_quality = 30

  // set number for multithreads
  fastp_threads = 1
  bwa_threads = 1
  mafft_threads = 1
  nxtclade_jobs = 1
  pangolin_threads = 1

  // HPC specific
  queue_size = 100

  // set Bam files minimum size treshold to be considered as input for Picard
  minBamSize = 500 //bytes


  // --- | Nanopore specific parameters | ---
  // General parameters
  base_container = "$projectDir/containers/baseContainer.sif"
  // Porechop parameters
  porechop_cpus = 4
  porechop_memory = 4.GB

  // minimap parameters
  minimap_cpus = 4
  minimap_memory = 4.GB

  // clair3 parameters
  // Clair3 v1.2.0, pinned by digest rather than by tag. Tags are mutable: if
  // upstream re-pointed v1.2.0, every run would silently move to a different
  // variant caller while the tests stayed on the digest they were validated
  // against. The same digest is declared in tests/nextflow.config, in the
  // truth test and in its expected_containers.tsv fixture, and
  // tests/test_container_recipes.py fails if the four disagree.
  clair3_container = "docker://hkubal/clair3@sha256:1430f7b520674bb282b5a1ba165e8555b012df67b9cdb22ff3d48f26cf1474a3"
  clair3_cpus = 4
  clair3_memory = 4.GB
  clair3_chunk_size = 10000
  clair3_qual = 10
  clair3_model = "r941_prom_sup_g5014"

  // bcftools parameters
  af_threshold = 0.51
  np_min_depth = 20
}

outputDir = params.outDir

executor {
   name = "local"
   //cpus = params.nextflowSimCalls
}

trace {
    enabled = true
    file = "${params.outDir}/RUN_METADATA/execution_trace.tsv"
    overwrite = true
    fields = 'task_id,hash,native_id,name,tag,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,container'
}

report {
    enabled = true
    file = "${params.outDir}/RUN_METADATA/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outDir}/RUN_METADATA/execution_timeline.html"
    overwrite = true
}


process {
    cache = "lenient"

    // Container directives are closures on purpose. A plain "${params.x}" is
    // resolved while this file is parsed, before -c config files and --params
    // from the command line are merged, so an override would be accepted and
    // silently ignored while the task ran the original image. A closure is
    // resolved per task, once the parameters are final.
    withLabel: "NP_basecontainer" {
        container = { params.base_container }
    }

    withName: run_porechop {
        cpus = params.porechop_cpus
        memory = params.porechop_memory
    }

    withName: run_minimap2 {
        cpus = params.minimap_cpus
        memory = params.minimap_memory
    }

    withName: run_clair3 {
        // The pinned reference carries a docker:// prefix, which Singularity
        // and Apptainer require and the Docker engine rejects outright
        // ("invalid reference format"). Strip it only for Docker, so one pinned
        // digest serves every engine and params.clair3_container stays the
        // single place the version is declared.
        container = {
            workflow.containerEngine == 'docker'
                ? params.clair3_container.replaceFirst(/^docker:\/\//, '')
                : params.clair3_container
        }
        cpus = params.clair3_cpus
        memory = params.clair3_memory
    }

}

// Included last so a profile can override the defaults above. Loading it before
// the params block meant profile params were silently overwritten.
includeConfig './configs/profiles.config'
